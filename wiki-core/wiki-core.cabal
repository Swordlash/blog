cabal-version:      3.0
name:               wiki-core
version:            0.1.0.0
synopsis:           The wiki's domain: types, Markdown rendering and permission rules
license:            NONE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

-- haskell-halogen's examples' stanza: the warnings every package here is built
-- with (cabal.project makes them errors) and the extensions its code assumes.
common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      Wiki.Core.Attachment
      Wiki.Core.Draft
      Wiki.Core.Export
      Wiki.Core.Id
      Wiki.Core.Markdown
      Wiki.Core.Markdown.Ast
      Wiki.Core.Markdown.Edit
      Wiki.Core.Markdown.Html
      Wiki.Core.Markdown.Link
      Wiki.Core.Markdown.Render
      Wiki.Core.Markdown.Tikz
      Wiki.Core.Math
      Wiki.Core.Order
      Wiki.Core.Page
      Wiki.Core.Path
      Wiki.Core.Permission
      Wiki.Core.Search
      Wiki.Core.Slug
      Wiki.Core.Space
      Wiki.Core.User
  build-depends:
      aeson,
      base,
      bytestring,
      commonmark >= 0.3.1 && < 0.4,
      commonmark-extensions >= 0.2.7.3 && < 0.3,
      containers,
      haskell-halogen-core,
      protolude,
      row-types,
      tagsoup >= 0.14.8 && < 0.15,
      text,
      time

  -- An archive as a zip file, natively only: zip-archive needs the C zlib
  -- through digest, which the WebAssembly toolchain lacks; the browser zips
  -- with fflate instead (web/src/archive.js).
  if !arch(wasm32)
    exposed-modules: Wiki.Core.Export.Zip
    build-depends:   zip-archive >= 0.4.3 && < 0.6

-- Runs natively, and under Node on wasm through toolchain/test-wasm.sh.
test-suite wiki-core-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Test.hs
  other-modules:
      Test.Attachment
      Test.Gen
      Test.Json
      Test.Markdown.Allowlist
      Test.Markdown.Ast
      Test.Markdown.Edit
      Test.Markdown.Link
      Test.Markdown.Tikz
      Test.Math
      Test.Order
      Test.Path
      Test.Permission
      Test.Permission.Writes
      Test.Search
      Test.Slug
  build-depends:
      QuickCheck,
      aeson,
      containers,
      hspec >= 2,
      protolude,
      text,
      time,
      wiki-core

-- How long a search takes, and how much it allocates, over a generated wiki
-- of a thousand pages; bench/README.md has the command and the numbers.
-- Native only, as haskell-halogen's benchmarks are: it measures the code,
-- not a backend.
benchmark search
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench
  main-is:          Search.hs
  ghc-options:      -rtsopts

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        criterion >= 1.6,
        protolude,
        text,
        time,
        wiki-core

-- The markup the renderer makes, through Halogen.Static's in-memory
-- document, which exists natively only (as wiki-app-test). The tree it is
-- made from is tested on both backends, in wiki-core-test.
test-suite wiki-core-html-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test-html
  main-is:          Test.hs

  if arch(wasm32)
    buildable: False
  else
    other-modules:
        Test.Markdown.Document
        Test.Markdown.Html
        Test.Markdown.RawHtml
        Test.Markdown.Render
    build-depends:
        QuickCheck,
        hspec >= 2,
        haskell-halogen-core,
        protolude,
        row-types,
        text,
        wiki-core
