cabal-version:      3.0
name:               wiki-api
version:            0.1.0.0
synopsis:           Request and response types shared by the wiki's client and server
license:            NONE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

-- haskell-halogen's examples' stanza: the warnings every package here is built
-- with (cabal.project makes them errors) and the extensions its code assumes.
common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      Wiki.Api
      Wiki.Api.Account
      Wiki.Api.Admin
      Wiki.Api.Auth
      Wiki.Api.Backups
      Wiki.Api.Comments
      Wiki.Api.Error
      Wiki.Api.Events
      Wiki.Api.Export
      Wiki.Api.Import
      Wiki.Api.Info
      Wiki.Api.Links
      Wiki.Api.Security
      Wiki.Api.ServerSettings
      Wiki.Api.Types
      Wiki.Api.Upload
      Wiki.Api.Version
      Wiki.Api.Zip
  build-depends:
      aeson,
      base,
      bytestring,
      containers,
      http-api-data,
      http-media,
      protolude,
      servant >= 0.20.3 && < 0.21,
      servant-multipart-api >= 0.13 && < 0.14,
      text,
      time,
      wiki-core

-- The API's types, natively and under Node on wasm through
-- toolchain/test-wasm.sh: the browser reads and writes them as much as the
-- server does.
test-suite wiki-api-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Test.hs
  other-modules:
      Test.Backups
      Test.Error
      Test.Events
      Test.Gen
      Test.Info
      Test.Json
      Test.Links
      Test.ServerSettings
      Test.Upload
      Test.Url
      Test.Version
  build-depends:
      QuickCheck,
      aeson,
      bytestring,
      containers,
      hspec >= 2,
      http-api-data,
      protolude,
      servant-multipart-api,
      text,
      time,
      wiki-api,
      wiki-core

-- The API served: golden files of the JSON a client depends on, and a server
-- of the API's type with stub handlers, requested at the addresses
-- Wiki.Api.Links makes. Native only, as the server is: servant-server and
-- servant-multipart do not build for the browser, and nothing here reads
-- files on wasm.
test-suite wiki-api-server-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test-server
  main-is:          Test.hs

  if arch(wasm32)
    buildable: False
  else
    other-modules:
        Test.Golden
        Test.Sample
        Test.Server
    build-depends:
        aeson,
        aeson-pretty,
        base,
        bytestring,
        case-insensitive,
        containers,
        hspec >= 2,
        http-types,
        protolude,
        servant,
        servant-multipart,
        servant-server,
        time,
        wai,
        wai-extra,
        wiki-api,
        wiki-core
