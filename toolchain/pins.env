# The toolchain's pins and floors, in one place. toolchain/bootstrap.sh
# sources this file, the maker (maker/) parses it, and
# toolchain/deploy-local.sh reads single lines of it. Only KEY=VALUE lines
# and comments: no quotes, no spaces around =, no shell beyond that.
#
# The pins must match haskell-halogen's .github/workflows/build.yml
# (GHC_VERSION, CABAL_VERSION, WASM_GHC_VERSION, GHC_WASM_META_REV) and the
# with-compiler of its cabal-wasm.project, for the haskell-halogen commit
# cabal.project pins: bump them together with that pin.
GHC_VERSION=9.14.1
CABAL_VERSION=3.16.1.0
WASM_GHC_VERSION=9.14.1.20260731
GHC_WASM_META_REV=358ea50b8496a69da6ce375c0c58bc049dbcb92d
GHC_WASM_FLAVOUR=9.14
# Not pinned by haskell-halogen: the ghcup used when none is installed, the
# Node the npm scripts and test runners use (haskell-halogen's need 24 or
# later), and the Playwright whose Chromium is installed until
# package-lock.json names one (haskell-halogen's package-lock.json).
GHCUP_VERSION=0.2.6.2
GHCUP_SHA256=9ed5da5449b48043a0d17e767c05d2ef585e25a639bb934329496c6d2fad9cf8
NODE_VERSION=24.21.0
NODE_SHA256=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
PLAYWRIGHT_VERSION=1.63.0
# The formatter, at the version the README names and CI checks with
# (.github/workflows/build.yml holds the same version and checksum). The
# checksum is that of the release's fourmolu-<version>-linux-x86_64.zip
# (since 0.20.0.0 the releases ship zips, one binary inside), checked before
# it is unpacked.
FOURMOLU_VERSION=0.21.0.0
FOURMOLU_SHA256=aadf6931653df7b96f52014cf8eb4285a3e8778cd0b531499fc3ee013e1e00c7
# libsodium, which every native build links statically: toolchain/libsodium.sh
# builds this release from source (the opaque package needs 1.0.19 or later,
# and Debian and Ubuntu ship 1.0.18). The checksum is that of the release's
# libsodium-<version>.tar.gz, the same file on download.libsodium.org and on
# the GitHub release <version>-RELEASE of jedisct1/libsodium, whose minisign
# signature by libsodium's key was checked when it was pinned.
# .github/workflows/build.yml and server-page.yml key their caches of the
# built library by both.
LIBSODIUM_VERSION=1.0.22
LIBSODIUM_SHA256=adbdd8f16149e81ac6078a03aca6fc03b592b89ef7b5ed83841c086191be3349
# The oldest tools --system-tools takes from the machine instead of the
# pins above. The pins are the tested versions: a tool between its floor
# and its pin is used with a warning. GHC 9.10 is the oldest GHC
# haskell-halogen builds and tests with: its CI runs GHC 9.10, 9.12 and
# 9.14, and haskell-halogen-th, which parses quotes with the compiler's own
# ghc library, asks for ghc >= 9.10 && < 9.15. 9.10 is also the first GHC
# with RequiredTypeArguments, which every package of the wiki enables. cabal
# 3.12 is the first cabal that reads the field semaphore: of cabal.project
# (and that has `cabal path`, which the bootstrap asks for the index's
# directory). Node 24 is what haskell-halogen's npm scripts and test runners
# need.
GHC_MIN_VERSION=9.10
CABAL_MIN_VERSION=3.12
NODE_MIN_MAJOR=24
