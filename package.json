  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0"
  },
  "scripts": {
    "build": "sh toolchain/npm-command.sh build-wasm",
    "serve": "sh toolchain/npm-command.sh serve-wasm",
    "build-native": "sh toolchain/npm-command.sh build-native",
    "test-native": "sh toolchain/npm-command.sh test-native",
    "build-wasm": "sh toolchain/npm-command.sh build-wasm",
    "build-wasm-opt": "sh toolchain/npm-command.sh build-wasm-opt",
    "serve-wasm": "sh toolchain/npm-command.sh serve-wasm",
    "test-wasm": "sh toolchain/npm-command.sh test-wasm",
    "test": "sh toolchain/npm-command.sh test",
    "dev-test": "sh toolchain/npm-command.sh dev-test",
    "smoke-test": "sh toolchain/smoke-test.sh",
    "screenshots": "node toolchain/screenshots.mjs",
    "deploy-local": "sh toolchain/deploy-local.sh",
    "undeploy-local": "sh toolchain/undeploy-local.sh",
    "format": "sh run_fourmolu.sh",
    "format-check": "sh run_fourmolu.sh --mode check",
