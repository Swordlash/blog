    "@lezer/highlight": "1.2.5",
    "@resvg/resvg-wasm": "2.6.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "openai": "7.45.0"
  }
