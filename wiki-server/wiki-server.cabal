cabal-version:      3.0
name:               wiki-server
version:            0.1.0.0
synopsis:           The wiki's server: persistence, and the application's files
license:            MIT
license-file:       LICENSE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- Embedded into the library at compile time (Wiki.Server.Storage.Migrate), so
-- that the binary carries its schema with it.
extra-source-files: migrations/*.sql
                    test/schemas/*.rng

-- haskell-halogen's examples' stanza: the warnings every package here is built
-- with (cabal.project makes them errors) and the extensions its code assumes.
common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces

-- The server: the storage (the wiki in SQLite and its attachments on disk,
-- behind the application's MonadWiki), the API's handlers, the application's
-- files, and the two listeners. Native only, as everything of the server is.
library
  import:           shared
  hs-source-dirs:   src

  if arch(wasm32)
    buildable: False
  else
    exposed-modules:
        Wiki.Server
        Wiki.Server.Accounts
        Wiki.Server.Address
        Wiki.Server.Api
        Wiki.Server.App
        Wiki.Server.Auth
        Wiki.Server.Backups
        Wiki.Server.Console
        Wiki.Server.Events
        Wiki.Server.Export
        Wiki.Server.Export.Document
        Wiki.Server.Health
        Wiki.Server.Feed
        Wiki.Server.Import
        Wiki.Server.Limiter
        Wiki.Server.Log
        Wiki.Server.Mail
        Wiki.Server.Metrics
        Wiki.Server.Notifier
        Wiki.Server.Oidc
        Wiki.Server.Options
        Wiki.Server.Password
        Wiki.Server.Presence
        Wiki.Server.Render
        Wiki.Server.Reset
        Wiki.Server.Routes
        Wiki.Server.SecondFactor
        Wiki.Server.Secret
        Wiki.Server.Session
        Wiki.Server.Static
        Wiki.Server.Version
        Wiki.Server.Storage
        Wiki.Server.Storage.Audit
        Wiki.Server.Storage.Backend
        Wiki.Server.Storage.Backup
        Wiki.Server.Storage.Blobs
        Wiki.Server.Storage.Comments
        Wiki.Server.Storage.Notifications
        Wiki.Server.Storage.Layout
        Wiki.Server.Storage.Migrate
        Wiki.Server.Storage.Postgres
        Wiki.Server.Storage.Rows
        Wiki.Server.Storage.Schema
        Wiki.Server.Storage.Sqlite
        Wiki.Server.Totp
        Wiki.Server.Vault
        Wiki.Server.WebAuthn
    other-modules:
        Paths_wiki_server
    autogen-modules:
        Paths_wiki_server
    build-depends:
        aeson,
        async,
        base,
        beam-core >= 0.11.1 && < 0.12,
        beam-postgres >= 0.6.4 && < 0.7,
        beam-sqlite >= 0.7 && < 0.8,
        bytestring,
        case-insensitive,
        cborg,
        containers,
        crypton,
        cryptohash-sha256,
        direct-sqlite,
        directory,
        file-embed,
        filepath,
        haskell-halogen-core,
        haskell-halogen-router,
        http-api-data,
        http-client,
        http-client-tls,
        http-types,
        network,
        optparse-applicative,
        pandoc,
        pandoc-types,
        postgresql-simple,
        process,
        protolude,
        qrcode-core >= 0.9.11 && < 0.10,
        ram,
        resource-pool,
        row-types,
        servant-client-core,
        servant-multipart,
        servant-server,
        smtp-mail >= 0.5.0.1,
        stm,
        texmath,
        wai-websockets >= 3.0.1 && < 3.1,
        websockets >= 0.13 && < 0.14,
        mime-mail,
        sqlite-simple,
        text,
        time,
        unix,
        unliftio-core,
        uuid-types,
        vector,
        wai,
        wai-extra,
        warp,
        wiki-api,
        wiki-app,
        wiki-core

-- Native only: a server has no business in the browser.
executable wiki-server
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  -- Warp needs the threaded runtime (its timeouts run on the I/O manager's
  -- timer), and requests are answered on every core.
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N" -Wno-unused-packages

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        optparse-applicative,
        protolude,
        wiki-server

-- The storage timed at the size of a big wiki (WP5.16a of docs/PLAN.md):
-- run by hand to compare two versions of it, and built with everything
-- else so that it keeps compiling. Native only, as the server is.
executable wiki-server-bench
  import:           shared
  main-is:          Bench.hs
  hs-source-dirs:   bench
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N" -Wno-unused-packages

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        aeson,
        base,
        bytestring,
        directory,
        filepath,
        protolude,
        sqlite-simple,
        temporary,
        text,
        time,
        wai,
        warp,
        websockets,
        wiki-api,
        wiki-app,
        wiki-core,
        wiki-server

-- The live heap of an export of 100 MiB of attachments and of an upload of
-- 50 MB, measured by the runtime (-T). A suite of its own, since the measure
-- is the largest over the whole process.
test-suite wiki-server-memory-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test-memory
  main-is:          Memory.hs
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-T"

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        HUnit,
        base,
        bytestring,
        containers,
        filepath,
        hspec >= 2,
        protolude,
        temporary,
        wiki-app,
        wiki-core,
        wiki-server

-- The storage against the backend's contract (wiki-app:contract), over a
-- database made afresh in a temporary directory for each example, and what
-- only the storage does: migrations, backups, attachments on disk. Then the
-- server, started on free ports of 127.0.0.1 and driven over HTTP: the API,
-- the application's files, the listeners' rules, export and import.
test-suite wiki-server-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Test.hs
  -- The tests start servers, which need the threaded runtime as the
  -- executable does.
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N" -Wno-unused-packages

  if arch(wasm32)
    buildable: False
  else
    other-modules:
        Test.Database
        Test.Storage
        Test.Storage.Accounts
        Test.Storage.Audit
        Test.Storage.Backup
        Test.Storage.Contract
        Test.Storage.Fixture
        Test.Storage.Migrate
        Test.Storage.Scale
    build-depends:
        HUnit,
        aeson,
        base,
        beam-core,
        bytestring,
        case-insensitive,
        cborg,
        containers,
        crypton,
        cryptohash-sha256,
        directory,
        filepath,
        hspec >= 2,
        http-api-data,
        postgresql-simple,
        unix,
        http-client,
        http-types,
        network,
        optparse-applicative,
        pandoc-types,
        process,
        protolude,
        ram,
        servant,
        sqlite-simple,
        temporary,
        text,
        time,
        wai,
        warp,
        websockets,
        wiki-api,
        wiki-app,
        wiki-app:contract,
        wiki-core,
        wiki-server,
        xml-conduit,
        zlib
