cabal-version:      3.0
name:               wiki-server
version:            0.1.0.0
synopsis:           The wiki's server: persistence, and the application's files
license:            NONE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- Embedded into the library at compile time (Wiki.Server.Storage.Migrate), so
-- that the binary carries its schema with it.
extra-source-files: migrations/*.sql

-- haskell-halogen's examples' stanza: the warnings every package here is built
-- with (cabal.project makes them errors) and the extensions its code assumes.
common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces

-- The server: the storage (the wiki in SQLite and its attachments on disk,
-- behind the application's MonadWiki), the API's handlers, the application's
-- files, and the two listeners. Native only, as everything of the server is.
library
  import:           shared
  hs-source-dirs:   src

  if arch(wasm32)
    buildable: False
  else
    exposed-modules:
        Wiki.Server
        Wiki.Server.Accounts
        Wiki.Server.Api
        Wiki.Server.App
        Wiki.Server.Auth
        Wiki.Server.Backups
        Wiki.Server.Console
        Wiki.Server.Events
        Wiki.Server.Export
        Wiki.Server.Export.Document
        Wiki.Server.Import
        Wiki.Server.Limiter
        Wiki.Server.Log
        Wiki.Server.Mail
        Wiki.Server.Oidc
        Wiki.Server.Options
        Wiki.Server.Password
        Wiki.Server.Presence
        Wiki.Server.Render
        Wiki.Server.Secret
        Wiki.Server.Session
        Wiki.Server.Static
        Wiki.Server.Version
        Wiki.Server.Storage
        Wiki.Server.Storage.Backup
        Wiki.Server.Storage.Blobs
        Wiki.Server.Storage.Comments
        Wiki.Server.Storage.Layout
        Wiki.Server.Storage.Migrate
        Wiki.Server.Storage.Rows
    other-modules:
        Paths_wiki_server
    autogen-modules:
        Paths_wiki_server
    build-depends:
        aeson,
        async,
        base,
        bytestring,
        case-insensitive,
        containers,
        crypton,
        cryptohash-sha256,
        direct-sqlite,
        directory,
        file-embed,
        filepath,
        haskell-halogen-core,
        haskell-halogen-router,
        http-api-data,
        http-client,
        http-client-tls,
        http-types,
        network,
        optparse-applicative,
        pandoc,
        pandoc-types,
        process,
        protolude,
        ram,
        servant-multipart,
        servant-server,
        smtp-mail >= 0.5.0.1,
        stm,
        texmath,
        wai-websockets >= 3.0.1 && < 3.1,
        websockets >= 0.13 && < 0.14,
        mime-mail,
        sqlite-simple,
        text,
        time,
        unix,
        unliftio-core,
        uuid-types,
        wai,
        wai-extra,
        warp,
        wiki-api,
        wiki-app,
        wiki-core

-- Native only: a server has no business in the browser.
executable wiki-server
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  -- Warp needs the threaded runtime (its timeouts run on the I/O manager's
  -- timer), and requests are answered on every core.
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        optparse-applicative,
        protolude,
        wiki-server

-- The storage against the backend's contract (wiki-app:contract), over a
-- database made afresh in a temporary directory for each example, and what
-- only the storage does: migrations, backups, attachments on disk. Then the
-- server, started on free ports of 127.0.0.1 and driven over HTTP: the API,
-- the application's files, the listeners' rules, export and import.
test-suite wiki-server-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Test.hs
  -- The tests start servers, which need the threaded runtime as the
  -- executable does.
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

  if arch(wasm32)
    buildable: False
  else
    other-modules:
        Test.Server.Access
        Test.Server.Accounts
        Test.Server.Backups
        Test.Server.Api
        Test.Server.Comments
        Test.Server.Export
        Test.Server.FakeProvider
        Test.Server.Fixture
        Test.Server.Http
        Test.Server.Import
        Test.Server.Mail
        Test.Server.Oidc
        Test.Server.Options
        Test.Server.Presence
        Test.Server.Render
        Test.Server.Settings
        Test.Server.Static
        Test.Storage
        Test.Storage.Accounts
        Test.Storage.Backup
        Test.Storage.Contract
        Test.Storage.Fixture
        Test.Storage.Migrate
    build-depends:
        HUnit,
        aeson,
        base,
        bytestring,
        case-insensitive,
        containers,
        cryptohash-sha256,
        directory,
        filepath,
        hspec >= 2,
        http-api-data,
        http-client,
        http-types,
        network,
        optparse-applicative,
        pandoc-types,
        protolude,
        ram,
        servant,
        sqlite-simple,
        temporary,
        text,
        time,
        wai,
        warp,
        websockets,
        wiki-api,
        wiki-app,
        wiki-app:contract,
        wiki-core,
        wiki-server
