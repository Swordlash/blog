    build-depends:
        HUnit,
        aeson,
        base,
        beam-core,
        bytestring,
        case-insensitive,
        cborg,
        containers,
        crypton,
        crypton-connection,
        directory,
        filepath,
        hspec >= 2,
        http-api-data,
        http-client,
        http-client-tls,
        http-types,
        ki,
        network,
        opaque-hs,
        optparse-applicative,
        pandoc-types,
        process,
        protolude,
        sel,
        ram,
