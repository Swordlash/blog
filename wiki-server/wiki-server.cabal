          Wiki.Server.Storage.Postgres
      build-depends:
          beam-postgres >= 0.6.4 && < 0.7,
          postgresql-simple

-- Native only: a server has no business in the browser.
executable wiki-server
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  -- Warp needs the threaded runtime (its timeouts run on the I/O manager's
  -- timer), and requests are answered on every core.
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        base,
        directory,
        optparse-applicative,
        protolude,
        sel,
        wiki-server

-- The storage timed at the size of a big wiki (WP5.16a of docs/PLAN.md):
-- run by hand to compare two versions of it, and built with everything
-- else so that it keeps compiling. Native only, as the server is.
executable wiki-server-bench
  import:           shared
  main-is:          Bench.hs
  hs-source-dirs:   bench
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        aeson,
        base,
        beam-core,
        bytestring,
        directory,
        filepath,
        protolude,
        temporary,
        text,
        time,
        wai,
        warp,
        websockets,
        wiki-api,
        wiki-app,
        wiki-core,
        wiki-server

-- The live heap of an export of 100 MiB of attachments and of an upload of
-- 50 MB, measured by the runtime (-T). A suite of its own, since the measure
-- is the largest over the whole process.
test-suite wiki-server-memory-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test-memory
  main-is:          Memory.hs
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-T"

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        HUnit,
        base,
        bytestring,
        containers,
        filepath,
        hspec >= 2,
        protolude,
        temporary,
        wiki-app,
        wiki-core,
        wiki-server

-- The storage against the backend's contract (wiki-app:contract), over a
-- database made afresh in a temporary directory for each example, and what
-- only the storage does: migrations, backups, attachments on disk. Then the
-- server, started on free ports of 127.0.0.1 and driven over HTTP: the API,
-- the application's files, the listeners' rules, export and import.
test-suite wiki-server-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Test.hs
  -- The tests start servers, which need the threaded runtime as the
  -- executable does. Large SQL fixtures benefit from a 16 MiB nursery
  -- per capability when several examples allocate at once.
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N -A16m"

  if arch(wasm32)
    buildable: False
  else
    -- The program itself, on PATH while the tests run: the tests of its
    -- console in a C locale run it as a child, as the rehearsal does.
    build-tool-depends: wiki-server:wiki-server
    other-modules:
        Test.Database
        Test.Server.Access
        Test.Server.Accounts
        Test.Server.Api
        Test.Server.Backups
        Test.Server.Comments
        Test.Server.Compress
        Test.Server.Export
        Test.Server.Feed
        Test.Server.Fixture
        Test.Server.Http
        Test.Server.Hygiene
        Test.Server.Guide
        Test.Server.Import
        Test.Server.Mail
        Test.Server.Metrics
        Test.Server.Notifications
        Test.Server.Observability
        Test.Server.Oidc
        Test.Server.Opaque
        Test.Server.Options
        Test.Server.Presence
        Test.Server.Program
        Test.Server.Rehearsal
        Test.Server.Render
        Test.Server.Settings
        Test.Server.Static
        Test.Server.Tls
        Test.Server.Totp
        Test.Server.Vault
        Test.Server.WaysIn
        Test.Server.WebAuthn
        Test.Server.WhatsNew
        Test.Storage
        Test.Storage.Accounts
        Test.Storage.Audit
        Test.Storage.Backup
        Test.Storage.CodeSteps
        Test.Storage.Contract
        Test.Storage.Copy
        Test.Storage.Fixture
        Test.Storage.Encrypted
