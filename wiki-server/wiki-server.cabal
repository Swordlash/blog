cabal-version:      3.0
name:               wiki-server
version:            0.1.0.0
synopsis:           The wiki's server: persistence, and the application's files
license:            MIT
license-file:       LICENSE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- Embedded into the library at compile time (Wiki.Server.Storage.Migrate), so
-- that the binary carries its schema with it. The changelog's entries too
-- (Wiki.Server.WhatsNew): changelog is a symbolic link to the repository's
-- changelog/, listed here so that an entry edited rebuilds the server. cabal
-- does not see a file added to a glob, so changelog.stamp, which
-- toolchain/changelog-stamp.sh writes before the builds with the entries'
-- names and the build's version, rebuilds it when an entry is added (or the
-- version changes); a build without the stamp (cabal by hand) still works.
extra-source-files: migrations/*.sql
                    changelog/*.md
                    changelog.stamp
                    test/schemas/*.rng

-- haskell-halogen's examples' stanza: the warnings every package here is built
-- with (cabal.project makes them errors) and the extensions its code assumes.
common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces

  -- The modules that reach PostgreSQL are compiled only with the flag
  -- postgres, and the code that chooses a database asks WIKI_POSTGRES.
  if flag(postgres)
    cpp-options: -DWIKI_POSTGRES

-- PostgreSQL as a database for the wiki, beside SQLite: on by default. A
-- deployment that keeps the wiki in SQLite builds with -postgres, and then
-- needs neither libpq nor pg_config (postgresql-libpq does not build
-- against an old libpq). Such a server refuses a PostgreSQL database with
-- "built without PostgreSQL".
flag postgres
  description: Keep the wiki in PostgreSQL too, not only in SQLite
  default:     True
  manual:      True

-- The server: the storage (the wiki in SQLite and its attachments on disk,
-- behind the application's MonadWiki), the API's handlers, the application's
-- files, and the two listeners. Native only, as everything of the server is.
