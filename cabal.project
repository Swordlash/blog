packages:
  wiki-core
  wiki-api
  wiki-app
  wiki-server

-- Build across packages in parallel and, through a semaphore cabal shares with
-- GHC (-jsem), across the modules of one package too. A change usually touches
-- one or two packages, where package-level parallelism alone would leave the
-- other cores idle; the semaphore keeps the whole build to $ncpus jobs rather
-- than cabal's jobs times GHC's. Every other project file imports this one.
jobs: $ncpus
semaphore: True

-- haskell-halogen comes from one pinned commit: only haskell-halogen-core is on
-- Hackage, and the application needs the router, the hooks and the th quoters
-- as well. Every package it is used from is listed, jsbits included (the WASM
-- FFI embeds its JavaScript at compile time), so all of them are at the same
-- commit. Bump the tag deliberately, in its own commit, together with the
-- toolchain pins in toolchain/bootstrap.sh and cabal-wasm.project.
source-repository-package
  type: git
  location: https://github.com/Swordlash/haskell-halogen
  tag: 1f934f2de4b8d3253e18f70287918e22009534d9
  subdir:
    core
    jsbits
    net
    hooks
    router
    th
    th-plugin
    hspec-halogen

-- network 3.2.10.0 (2026-10) exports getHostName from Network.Socket, which
-- smtp-mail 0.5.0.1 also imports from Network.BSD, so smtp-mail no longer
-- compiles with it (an ambiguous occurrence). Until smtp-mail is fixed, the
-- solver is kept on the network before it.
constraints: network < 3.2.10

-- As in haskell-halogen's own cabal.project: protolude's upper bounds lag
-- behind the GHC this builds with. servant's, http-api-data's and
-- monad-control's (servant-server's) lag behind the QuickCheck, text-iso8601
-- and transformers-compat everything else here is built with: kept to them,
-- the solver would take older versions and rebuild aeson, protolude and every
-- package above them for the API's sake alone. serialise's and cborg's lag behind the base,
-- ghc-prim, containers and time of GHC 9.14: tls needs serialise (over cborg),
-- and the server's mail (smtp-mail, over crypton-connection and tls) needs tls;
-- without them the solver falls back to a tls of crypton 1, whose memory
-- package is not the ram the server's crypton 2 speaks. pandoc's crypton
-- (< 2.1) and pandoc-types' QuickCheck (< 2.19) lag behind those the rest is
-- built with: kept to them, linking pandoc into the server (its export)
-- would take an older crypton and tls and rebuild aeson, servant, warp and
-- everything above them a second time, for pandoc's sake alone. pandoc uses
-- crypton for its hashes (MD5, SHA-1), and pandoc-types QuickCheck for its
-- Arbitrary instances.
-- qrcode-core's containers bound lags behind GHC 9.14's (the server draws a
-- second factor's QR code with it, Wiki.Server.Totp).
-- postgresql-simple's bounds on base, template-haskell, containers,
-- bytestring, aeson and attoparsec lag behind GHC 9.14 and the versions
-- the rest is built with, and dependent-map's (beam-migrate's, which
-- beam-sqlite and beam-postgres need) on containers does too: the server
-- reaches PostgreSQL through beam-postgres over postgresql-simple
-- (Wiki.Server.Storage.Postgres).
-- webauthn 0.12.0.0 (the passkeys' checks, Wiki.Server.WebAuthn) bounds
-- base, time, crypton and the crypton-x509 packages below GHC 9.14's and
-- below the crypton 2 and x509 1.10 everything else is built with; it builds
-- and passes its use here with them.
allow-newer:
  protolude:*,
  servant:QuickCheck,
  http-api-data:text-iso8601,
  monad-control:transformers-compat,
  serialise:base,
  serialise:ghc-prim,
  serialise:containers,
  serialise:time,
  cborg:base,
  cborg:ghc-prim,
  cborg:containers,
  pandoc:crypton,
  pandoc-types:QuickCheck,
  qrcode-core:containers,
  postgresql-simple:*,
  dependent-map:containers,
  webauthn:base,
  webauthn:crypton,
  webauthn:crypton-x509,
  webauthn:crypton-x509-store,
  webauthn:crypton-x509-validation,
  webauthn:time

-- A test suite's dependencies are optional goals unless this says otherwise:
-- rather than report that it cannot satisfy them, the solver is free to hand
-- back a plan with no test suites in it, and `cabal test` then fails with
-- nothing to run. Asking for them here makes an unsatisfiable test dependency
-- an error that names itself, and gives the build and test steps one plan
-- between them rather than one each.
tests: True

-- Warnings are errors in this repository's own packages (program-options
-- applies to local packages only, not to dependencies). It lives here rather
-- than in the .cabal files so that a newer GHC warning about something new
-- does not stop a package from building for someone else.
program-options
  ghc-options: -Werror

-- The server's export (Wiki.Server.Export) links pandoc as a library. Its
-- data files (templates, the reference DOCX and PPTX) are embedded in the
-- binary, pandoc's default, so the server needs nothing installed beside it.
-- Without http, pandoc cannot fetch a resource from the network while it
-- writes a document: an export reads images and attachments from the wiki's
-- own blob store, and a page's link to some other host must not make the
-- server fetch it.
package pandoc
  flags: +embed_data_files -http
