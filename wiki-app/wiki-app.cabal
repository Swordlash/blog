cabal-version:      3.0
name:               wiki-app
version:            0.1.0.0
synopsis:           The wiki's browser application, in Halogen
license:            MIT
license-file:       LICENSE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- Embedded into the wasm binary at compile time by Halogen.JSBits: the
-- application's, and the browser test suite's own.
extra-source-files:
    jsbits/*.js
    test/jsbits/*.js
    -- The export archive of version 1, which every later version imports.
    test/data/*.zip

flag interactive
  description: Build the browser test suite for browser GHCi (toolchain/dev-test.sh)
  default:     False
  manual:      True

-- haskell-halogen's examples' stanza: the warnings every package here is built
-- with (cabal.project makes them errors) and the extensions its code assumes.
common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      Wiki.App
      Wiki.App.Account
      Wiki.App.Assistant
      Wiki.App.Assistant.Keys
      Wiki.App.Assistant.Sync
      Wiki.App.Backend
      Wiki.App.Backend.Admin
      Wiki.App.Backend.Comments
      Wiki.App.Backend.Http
      Wiki.App.Backend.Http.Cache
      Wiki.App.Backend.Http.Client
      Wiki.App.Backend.Http.Preload
      Wiki.App.Backend.Http.Transport
      Wiki.App.Backend.Mem
      Wiki.App.Backend.Mem.Archive
      Wiki.App.Backend.Mem.Persist
      Wiki.App.Backend.Mem.State
      Wiki.App.Backend.Notifications
      Wiki.App.Browser
      Wiki.App.Demo
      Wiki.App.Guide
      Wiki.App.DemoUsers
      Wiki.App.Head
      Wiki.App.Import
      Wiki.App.Islands
      Wiki.App.Islands.Monad
      Wiki.App.Live
      Wiki.App.Offline
      Wiki.App.Recent
      Wiki.App.Route
      Wiki.App.Security
      Wiki.App.Shell
      Wiki.App.Editor.Browser
      Wiki.App.View.Access
      Wiki.App.View.Activity
      Wiki.App.View.Assistant
      Wiki.App.View.AssistantSettings
      Wiki.App.View.Backups
      Wiki.App.View.Invite
      Wiki.App.View.Bell
      Wiki.App.View.Blog
      Wiki.App.View.Body
      Wiki.App.View.Comments
      Wiki.App.View.Common
      Wiki.App.View.Diff
      Wiki.App.View.Directory
      Wiki.App.View.Editor
      Wiki.App.View.Groups
      Wiki.App.View.Export
      Wiki.App.View.Import
      Wiki.App.View.NewPage
      Wiki.App.View.NewSpace
      Wiki.App.View.NotificationSettings
      Wiki.App.View.Page
      Wiki.App.View.Permissions
      Wiki.App.View.Preview
      Wiki.App.View.LivePreview
      Wiki.App.View.ProviderIcons
      Wiki.App.View.Reset
      Wiki.App.View.Search
      Wiki.App.View.SearchResults
      Wiki.App.View.Security
      Wiki.App.View.Server
      Wiki.App.View.SignIn
      Wiki.App.View.Slides
      Wiki.App.View.History
      Wiki.App.View.Source
      Wiki.App.View.Space
      Wiki.App.View.SpaceSettings
      Wiki.App.View.Status
      Wiki.App.View.Unsubscribe
      Wiki.App.View.UserDialog
      Wiki.App.View.Users
      Wiki.App.View.VerifyEmail
      Wiki.App.View.Watch

  -- The version "Export the wiki" writes into an archive's manifest.
  other-modules:    Paths_wiki_app
  autogen-modules:  Paths_wiki_app

  -- Rendering for the prerender and the native tests, through the in-memory
  -- document, which exists on a host GHC only.
  if !arch(wasm32)
    exposed-modules:
        Wiki.App.Static

  build-depends:
      aeson,
      base,
      base64-bytestring,
      bytestring,
      case-insensitive,
      containers,
      free,
      http-media,
      http-types,
      primitive,
      protolude,
      row-types,
      servant,
      servant-client-core >= 0.20.3 && < 0.21,
      servant-multipart-api,
      servant-multipart-client >= 0.13 && < 0.14,
      text,
      time,
      transformers,
      unliftio-core,
      uuid-types,
      haskell-halogen-core,
      haskell-halogen-jsbits,
      haskell-halogen-net,
      haskell-halogen-router,
      haskell-halogen-th,
      wiki-api,
      wiki-core

  -- The views are written as HTML through haskell-halogen-th's hh quoter.
  -- Natively its plugin expands each quote as the module is parsed, so that
  -- an error inside one is reported at its line and column (and a language
  -- server shows it there); a plugin cannot run in the WebAssembly cross
  -- compiler, where the quoter itself does the same work.
  if !arch(wasm32)
    build-depends: haskell-halogen-th-plugin
    ghc-options:   -fplugin=Halogen.TH.Plugin

-- The backend's contract: what every MonadWiki (and MonadAdmin) does, as an hspec spec that a
-- test suite runs against its backend with a fixture of its own. A library of
-- its own so that this package's tests (the in-memory backend) and
-- wiki-server's (the SQLite storage) run the one spec. Natively only, as both
-- suites are.
library contract
  import:           shared
  visibility:       public
  hs-source-dirs:   contract

  if arch(wasm32)
    buildable: False
  else
    exposed-modules:
        Wiki.App.Backend.Contract
        Wiki.App.Backend.Contract.Admin
        Wiki.App.Backend.Contract.Comments
        Wiki.App.Backend.Contract.Notifications
    build-depends:
        HUnit,
        bytestring,
        containers,
        hspec >= 2,
        protolude,
        text,
        time,
        wiki-api,
        wiki-app,
        wiki-core

-- The application itself: a wasm reactor whose hs_start web/index.js calls.
executable wiki-app
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
      protolude,
      haskell-halogen-core

  -- Natively Main.hs only type-checks the entry point: the component is
  -- mounted in a browser alone.
  if arch(wasm32)
    build-depends:
        haskell-halogen-router,
        wiki-app
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

-- The page with the component already rendered into it, written natively at
-- build time (toolchain/build-wasm.sh runs it). Keep this helper native at
-- -O0 so it compiles quickly and shares the native Cabal store.
executable wiki-app-prerender
  import:           shared
  main-is:          Prerender.hs
  hs-source-dirs:   app

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        base,
        bytestring,
        directory,
        filepath,
        protolude,
        text,
        haskell-halogen-core,
        haskell-halogen-router,
        wiki-app

-- What the component renders, through Halogen.Static's in-memory document,
-- and the backend's contract, run against the in-memory backend over IO. In a browser, toolchain/smoke-test.mjs drives
-- the built page.
test-suite wiki-app-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Test.hs

  if arch(wasm32)
    buildable: False
  else
    -- Parallel JSON and DOM fixtures need fewer global garbage collections.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N -A16m"
    other-modules:
        Test.Assistant
        Test.Backend.Http
        Test.Backend.Mem
        Test.Backend.Persist
        Test.Blog
        Test.Counting
        Test.Demo
        Test.Guide
        Test.Export
        Test.Hydrate
        Test.Import
        Test.Islands
        Test.Licence
        Test.Link
        Test.Live
        Test.Manifest
        Test.Passwords
        Test.Policy
        Test.Readme
        Test.Route
        Test.Scripted
        Test.Server
        Test.Shell
    build-depends:
        HUnit,
        QuickCheck,
        aeson,
        base,
        base64-bytestring,
        bytestring,
        case-insensitive,
        containers,
        directory,
        hspec >= 2,
        http-media,
        http-types,
        protolude,
        servant-client-core,
        text,
        time,
        unliftio-core,
        haskell-halogen-core,
        haskell-halogen-net,
        haskell-halogen-router,
        wiki-api,
        wiki-app,
        wiki-app:contract,
        wiki-core

-- The islands in headless Chromium, with the page's islands.js and
-- islands.css loaded (test/web/bundle.sh): the hspec-halogen executable, as
-- toolchain/wasm-test-wrapper.sh hands it the suite, loads the wasm reactor
-- into a page with them. Natively it builds, so that it type-checks, and
-- reports that it skipped.
test-suite wiki-app-browser-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          BrowserTest.hs
  other-modules:
      Test.Browser.Access
      Test.Browser.Activity
      Test.Browser.Admin
      Test.Browser.Assistant
      Test.Browser.Backups
      Test.Browser.Comments
      Test.Browser.Contents
      Test.Browser.Editor
      Test.Browser.Export
      Test.Browser.History
      Test.Browser.HomePage
      Test.Browser.Http
      Test.Browser.Hydrate
      Test.Browser.Import
      Test.Browser.Islands
      Test.Browser.Macros
      Test.Browser.Mount
      Test.Browser.Notifications
      Test.Browser.Offline
      Test.Browser.Order
      Test.Browser.Permissions
      Test.Browser.Persist
      Test.Browser.Policy
      Test.Browser.Providers
      Test.Browser.Search
      Test.Browser.Security
      Test.Browser.Server
      Test.Browser.Shell
      Test.Browser.Slides
      Test.Browser.Source
      Test.Browser.Spaces
      Test.Browser.Text
      Test.Browser.Vault
      Test.Browser.Workspace
      Test.Counting
  build-depends:
      aeson,
      base,
      base64-bytestring,
      bytestring,
      containers,
      protolude,
      row-types,
      text,
      time,
      unliftio-core,
      haskell-halogen-core,
      haskell-halogen-jsbits,
      haskell-halogen-router,
      hspec-halogen,
      wiki-api,
      wiki-app,
      wiki-core

  if arch(wasm32)
    build-depends: hspec >= 2

  if arch(wasm32) && !flag(interactive)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

  -- GHCi's :main (under the interactive flag) runs
  -- System.Environment.withArgs and Control.Monad.void, which it finds only in
  -- a package the suite depends on: base, which the suite needs anyway for
  -- Data.IORef, which Protolude does not export.
  if flag(interactive)
    cpp-options: -DINTERACTIVE
