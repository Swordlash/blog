  -- The version "Export the wiki" writes into an archive's manifest.
  other-modules:    Paths_wiki_app
  autogen-modules:  Paths_wiki_app

  -- Rendering for the prerender and the native tests, through the in-memory
  -- document, which exists on a host GHC only.
  if !arch(wasm32)
    exposed-modules:
        Wiki.App.Static

  -- opaque-hs is the client's half of OPAQUE (Wiki.App.Backend.Opaque) on
  -- both targets: natively over libsodium, and on wasm32 the package's
  -- client alone, which calls @serenity-kit/opaque.
  build-depends:
      aeson,
      base,
      base64-bytestring,
      bytestring,
      case-insensitive,
      containers,
      free,
      http-media,
      http-types,
      primitive,
      protolude,
      row-types,
      servant,
      servant-client-core >= 0.20.3 && < 0.21,
      servant-multipart-api,
      servant-multipart-client >= 0.13 && < 0.14,
      template-haskell,
      text,
      time,
      transformers,
      unliftio-core,
      uuid-types,
      haskell-halogen-core,
      haskell-halogen-jsbits,
      haskell-halogen-net,
      haskell-halogen-router,
      haskell-halogen-th,
      opaque-hs,
      wiki-api,
      wiki-core

  -- The views are written as HTML through haskell-halogen-th's hh quoter.
  -- Natively its plugin expands each quote as the module is parsed, so that
  -- an error inside one is reported at its line and column (and a language
  -- server shows it there); a plugin cannot run in the WebAssembly cross
  -- compiler, where the quoter itself does the same work.
  if !arch(wasm32)
    build-depends: haskell-halogen-th-plugin
    ghc-options:   -fplugin=Halogen.TH.Plugin

-- The backend's contract: what every MonadWiki (and MonadAdmin) does, as an hspec spec that a
-- test suite runs against its backend with a fixture of its own. A library of
-- its own so that this package's tests (the in-memory backend) and
-- wiki-server's (the SQLite storage) run the one spec. Natively only, as both
-- suites are.
library contract
  import:           shared
  visibility:       public
  hs-source-dirs:   contract

  if arch(wasm32)
    buildable: False
  else
    exposed-modules:
        Wiki.App.Backend.Contract
        Wiki.App.Backend.Contract.Admin
        Wiki.App.Backend.Contract.Backlinks
        Wiki.App.Backend.Contract.Comments
        Wiki.App.Backend.Contract.Notifications
        Wiki.App.Backend.Contract.Stars
    build-depends:
        HUnit,
        bytestring,
        containers,
        hspec >= 2,
        protolude,
        text,
        time,
        wiki-api,
        wiki-app,
        wiki-core

-- The application itself: a wasm reactor whose hs_start web/index.js calls.
executable wiki-app
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
      protolude,
      haskell-halogen-core

  -- Natively Main.hs only type-checks the entry point: the component is
  -- mounted in a browser alone.
  if arch(wasm32)
    build-depends:
        haskell-halogen-router,
        wiki-app
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

-- The page with the component already rendered into it, written natively at
-- build time (toolchain/build-wasm.sh runs it). Keep this helper native at
-- -O0 so it compiles quickly and shares the native Cabal store.
executable wiki-app-prerender
  import:           shared
  main-is:          Prerender.hs
  hs-source-dirs:   app

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        base,
        bytestring,
        directory,
        filepath,
        protolude,
        text,
        haskell-halogen-core,
        haskell-halogen-router,
        wiki-app

-- What the component renders, through Halogen.Static's in-memory document,
-- and the backend's contract, run against the in-memory backend over IO. In a browser, wiki-smoke's demo suite drives
-- the built page.
test-suite wiki-app-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Test.hs

  if arch(wasm32)
    buildable: False
  else
    -- Parallel JSON and DOM fixtures need fewer global garbage collections.
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N -A16m"
    other-modules:
        Test.Assistant
        Test.Backend.Http
        Test.Backend.Opaque
        Test.Bell
        Test.BellDom
        Test.BellHarness
        Test.Opaque
        Test.Browser.Opaque
        Test.Backend.Mem
        Test.Backend.Persist
        Test.Blog
        Test.Counting
        Test.Demo
        Test.Entries
        Test.Guide
        Test.Help
        Test.DecryptedExport
        Test.Export
        Test.Favicon
        Test.Harness.MemDom
        Test.Hydrate
        Test.Import
        Test.Islands
        Test.Latest
        Test.Licence
        Test.Link
        Test.Live
        Test.Manifest
        Test.Passwords
        Test.Policy
        Test.Problems
        Test.Readme
        Test.Rect
        Test.Route
        Test.Scripted
        Test.Server
        Test.Shell
        Test.Threads
        Test.Ticking
    build-depends:
        HUnit,
        QuickCheck,
        aeson,
        base,
        base64-bytestring,
        bytestring,
        case-insensitive,
        containers,
        directory,
        hspec >= 2,
        http-media,
        http-types,
        opaque-hs,
        primitive,
        protolude,
        row-types,
        servant,
        servant-client-core,
        servant-multipart-api,
        stm,
        text,
        time,
        transformers,
        unliftio-core,
        haskell-halogen-core,
        haskell-halogen-net,
        haskell-halogen-router,
        wiki-api,
        wiki-app,
        wiki-app:contract,
        wiki-core

-- The islands in headless Chromium, with the page's islands.js and
-- islands.css loaded (test/web/bundle.sh): the hspec-halogen executable, as
-- toolchain/wasm-test-wrapper.sh hands it the suite, loads the wasm reactor
-- into a page with them. Natively it builds, so that it type-checks, and
-- reports that it skipped.
test-suite wiki-app-browser-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          BrowserTest.hs
  other-modules:
      Test.Browser.Opaque
      Test.Browser.Access
      Test.Browser.Activity
      Test.Browser.Admin
      Test.Browser.Assistant
      Test.Browser.Backups
      Test.Browser.Comments
      Test.Browser.Contents
      Test.Browser.CopyCode
      Test.Browser.DeckViewer
      Test.Browser.Editor
      Test.Browser.EditorSearch
      Test.Browser.Emoji
      Test.Browser.Entries
      Test.Browser.Export
      Test.Browser.Favicon
      Test.Browser.History
      Test.Browser.HomePage
      Test.Browser.Encrypted
      Test.Browser.Hpke
      Test.Browser.HtmlBlock
      Test.Browser.Http
      Test.Browser.Hydrate
      Test.Browser.Import
      Test.Browser.Islands
      Test.Browser.Macros
      Test.Browser.Menus
      Test.Browser.Mount
      Test.Browser.Notifications
      Test.Browser.Offline
      Test.Browser.Order
      Test.Browser.Permissions
      Test.Browser.Persist
      Test.Browser.Personal
      Test.Browser.Avatars
      Test.Browser.Policy
      Test.Browser.Problems
      Test.Browser.Folds
      Test.Browser.Providers
      Test.Browser.Search
      Test.Browser.Security
      Test.Browser.Server
      Test.Browser.EditorSettings
      Test.Browser.Shell
      Test.Browser.SlideEditor
      Test.Browser.SlideRows
      Test.Browser.Slides
      Test.Browser.Source
      Test.Browser.Spaces
      Test.Browser.Spoilers
      Test.Browser.Stars
      Test.Browser.Tasks
      Test.Browser.WhatsNew
      Test.Browser.Text
      Test.Browser.Vault
      Test.Browser.Workspace
      Test.Counting
  build-depends:
      aeson,
      base,
      base64-bytestring,
      bytestring,
      containers,
      protolude,
      row-types,
      text,
      time,
      unliftio-core,
      haskell-halogen-core,
      haskell-halogen-jsbits,
      haskell-halogen-router,
      hspec-halogen,
      wiki-api,
      wiki-app,
      wiki-core

  if arch(wasm32)
    build-depends: hspec >= 2

  if arch(wasm32) && !flag(interactive)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

  -- GHCi's :main (under the interactive flag) runs
  -- System.Environment.withArgs and Control.Monad.void, which it finds only in
  -- a package the suite depends on: base, which the suite needs anyway for
  -- Data.IORef, which Protolude does not export.
  if flag(interactive)
    cpp-options: -DINTERACTIVE

-- The bell tested over haskell-halogen-remote (WP5.118's spike): mounted
-- natively in this process over the in-memory backend with its asks held,
-- in remote's RemoteDOM, its DOM shown in headless Chromium over a
-- WebSocket and driven by haskell-halogen-playwright. No wasm build. It
-- needs node, the npm package playwright and Chromium, as the smoke suites
-- do, and reports its examples pending unless WIKI_REMOTE_REQUIRED=1, so
-- that a plain cabal test passes without a browser.
test-suite wiki-app-remote-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          RemoteTest.hs

  if arch(wasm32) || arch(javascript)
    buildable: False
  else
    ghc-options: -threaded
    other-modules:
        Test.Bell
        Test.BellHarness
        Test.Harness.MemDom
        Test.Remote.Bell
    build-depends:
        QuickCheck,
        aeson,
        base,
        containers,
        hspec >= 2,
        primitive,
        protolude,
        row-types,
        stm,
        text,
        time,
        transformers,
        unliftio-core,
        haskell-halogen-core,
        haskell-halogen-playwright,
        haskell-halogen-remote,
        haskell-halogen-router,
        wiki-api,
        wiki-app,
        wiki-core
