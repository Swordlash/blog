cabal-version:      3.0
name:               wiki-app
version:            0.1.0.0
synopsis:           The wiki's browser application, in Halogen
license:            NONE
author:             Mateusz Goślinowski
maintainer:         mateusz.goslinowski@gmail.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- Embedded into the wasm binary at compile time by Halogen.JSBits.
extra-source-files: jsbits/*.js

flag interactive
  description: Build the browser test suite for browser GHCi (toolchain/dev-test.sh)
  default:     False
  manual:      True

-- haskell-halogen's examples' stanza: the warnings every package here is built
-- with (cabal.project makes them errors) and the extensions its code assumes.
common shared
  default-language: GHC2021
  ghc-options: -Wall -Wextra -Wcompat -Wno-partial-type-signatures -Wterm-variable-capture -Wredundant-constraints -Wunused-packages

  default-extensions:
      RankNTypes
      GeneralizedNewtypeDeriving
      MultiParamTypeClasses
      FunctionalDependencies
      FlexibleContexts
      FlexibleInstances
      UndecidableInstances
      GADTs
      DeriveFunctor
      DerivingStrategies
      NoImplicitPrelude
      KindSignatures
      DataKinds
      OverloadedStrings
      TypeOperators
      LambdaCase
      TypeFamilies
      OverloadedRecordDot
      RecordWildCards
      NamedFieldPuns
      DuplicateRecordFields
      PartialTypeSignatures
      DefaultSignatures
      StandaloneKindSignatures
      NoFieldSelectors
      DerivingVia
      CPP
      StrictData
      RequiredTypeArguments
      ExplicitNamespaces

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      Wiki.App
      Wiki.App.Backend
      Wiki.App.Backend.Mem
      Wiki.App.Backend.Mem.State
      Wiki.App.Browser
      Wiki.App.Demo
      Wiki.App.DemoUsers
      Wiki.App.Islands
      Wiki.App.Islands.Monad
      Wiki.App.Route
      Wiki.App.Shell
      Wiki.App.View.Common
      Wiki.App.View.NewSpace
      Wiki.App.View.Page
      Wiki.App.View.Space

  -- Rendering for the prerender and the native tests, through the in-memory
  -- document, which exists on a host GHC only.
  if !arch(wasm32)
    exposed-modules:
        Wiki.App.Static

  build-depends:
      base,
      base64-bytestring,
      bytestring,
      containers,
      primitive,
      protolude,
      row-types,
      text,
      time,
      transformers,
      unliftio-core,
      haskell-halogen-core,
      haskell-halogen-jsbits,
      haskell-halogen-router,
      wiki-core

-- The application itself: a wasm reactor whose hs_start web/index.js calls.
executable wiki-app
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
      protolude,
      haskell-halogen-core

  -- Natively Main.hs only type-checks the entry point: the component is
  -- mounted in a browser alone.
  if arch(wasm32)
    build-depends:
        haskell-halogen-router,
        wiki-app
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

-- The page with the component already rendered into it, written natively at
-- build time (toolchain/build-wasm.sh runs it). Only a host GHC renders to
-- HTML, so there is nothing to build on wasm.
executable wiki-app-prerender
  import:           shared
  main-is:          Prerender.hs
  hs-source-dirs:   app

  if arch(wasm32)
    buildable: False
  else
    build-depends:
        base,
        bytestring,
        containers,
        directory,
        filepath,
        protolude,
        text,
        haskell-halogen-core,
        haskell-halogen-router,
        wiki-app,
        wiki-core

-- What the component renders, through Halogen.Static's in-memory document,
-- which exists natively only, and the backend's contract, run against the
-- in-memory backend over IO. In a browser, toolchain/smoke-test.mjs drives
-- the built page.
test-suite wiki-app-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Test.hs

  if arch(wasm32)
    buildable: False
  else
    other-modules:
        Test.Backend.Contract
        Test.Backend.Mem
        Test.Demo
        Test.Islands
        Test.Link
        Test.Route
        Test.Shell
    build-depends:
        HUnit,
        QuickCheck,
        base,
        base64-bytestring,
        bytestring,
        containers,
        hspec >= 2,
        protolude,
        text,
        time,
        haskell-halogen-core,
        haskell-halogen-router,
        wiki-app,
        wiki-core

-- The islands in headless Chromium, with the page's islands.js and
-- islands.css loaded (test/web/bundle.sh): the hspec-halogen executable, as
-- toolchain/wasm-test-wrapper.sh hands it the suite, loads the wasm reactor
-- into a page with them. Natively it builds, so that it type-checks, and
-- reports that it skipped.
test-suite wiki-app-browser-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          BrowserTest.hs
  other-modules:
      Test.Browser.Islands
      Test.Browser.Shell
  build-depends:
      protolude,
      row-types,
      text,
      haskell-halogen-core,
      haskell-halogen-router,
      hspec-halogen,
      wiki-app,
      wiki-core

  if arch(wasm32) && !flag(interactive)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"

  if flag(interactive)
    cpp-options: -DINTERACTIVE
    -- GHCi's :main runs System.Environment.withArgs and Control.Monad.void,
    -- which it finds only in a package the suite depends on. The suite's own
    -- code needs nothing of base's beyond Protolude, so only GHCi gets it.
    build-depends: base
