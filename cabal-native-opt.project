-- The production build of the server, which `toolchain/deploy-local.sh
-- --server` deploys: the same project as cabal.project, which it imports so
-- that the haskell-halogen pin, allow-newer and -Werror stay in one place,
-- with this repository's own packages compiled at -O2.
--
-- Unlike cabal-wasm-opt.project, the dependencies keep the optimisation the
-- everyday native build gives them, so that they come from the cabal store as
-- they are rather than being compiled again: the server's own code is where
-- -O2 is worth its build time. Built in its own directory
-- (dist-newstyle/native-opt), so that switching between this and the everyday
-- build in dist-newstyle/native never invalidates either; without the test
-- suites, which a deployment does not run.
import: cabal.project

-- cabal.project turns optimisation off for the everyday build, package by
-- package; the stanzas below turn it on again and give -O2.

tests: False

-- The build semaphore of cabal.project is off here. It is a POSIX named
-- semaphore that cabal makes and each GHC opens (-jsem), and some machines
-- refuse it: on a RHEL 9 server every package's build failed with "semOpen:
-- does not exist". A build of this file by hand, or the Dockerfile's, must
-- not depend on it. toolchain/deploy-local.sh first runs
-- toolchain/check-semaphore.sh, which tries the semaphore the way a build
-- uses it, and builds with --semaphore when the semaphore works there
-- (its options --semaphore and --no-semaphore decide instead of the probe).
--
-- jobs: $ncpus builds the dependencies in parallel, one package per core.
-- With the semaphore on, cabal gives GHC -jsem, and the modules of a package
-- compile in parallel too, within the same $ncpus jobs. With it off, each
-- GHC compiles one module at a time: a -j in the packages' ghc-options would
-- give each of the $ncpus GHCs every core.
semaphore: False
jobs: $ncpus

package opaque
  optimization: True

package wiki-core
  optimization: True
  ghc-options: -O2

package wiki-api
  optimization: True
  ghc-options: -O2

package wiki-app
  optimization: True
  ghc-options: -O2

package wiki-server
  optimization: True
  ghc-options: -O2
